# ARIEC61850 source repository hygiene
# Keep this repository source-first: no IDE state, build output, generated evidence, captures, or release packages.

# Visual Studio / IDE state
.vs/
.idea/
.dotnet_home/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# .NET build output
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esults/
[Cc]overage/
[Dd]ebug/
[Rr]elease/
*.dll
*.exe
*.pdb
*.deps.json
*.runtimeconfig.json
*.nupkg
*.snupkg
*.binlog
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml
coverage.opencover.xml

# MSBuild files and test-runner output sometimes emitted outside bin/obj
**/[Bb]in/
**/[Oo]bj/
**/[Tt]est[Rr]esults/
**/[Cc]overage*/
*.csproj.FileListAbsolute.txt
*.nuget.g.props
*.nuget.g.targets
project.assets.json
project.nuget.cache

# Centralized local build/publish output from Directory.Build.props and scripts
.artifacts/
artifacts/
out/
publish/
release/
$(MSBuildProjectDirectory)/

# Local Windows packages and archives produced by publish/installer workflows
AppPackages/
BundleArtifacts/
*.appx
*.appxbundle
*.msix
*.msixbundle
*.msi
*.cab
*.zip

# Runtime evidence and lab captures
evidence/
captures/
pcaps/
reports/
logs/
*.pcap
*.pcapng
*.etl
*.evtx
*.log
*.csv

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.cache
*.bak
*.orig
*.swp
~$*
