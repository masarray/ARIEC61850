<Window x:Class="AR.Iec61850.IedDiscovery.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IEC 61850 Control Tester"
        Height="760" Width="790" MinHeight="680" MinWidth="720"
        Background="#F4F7FB" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="#D4DCE7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#27364A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,16,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#C7D1DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#C7D1DE" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B5FA5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="  ARIEC61850 Smart Control" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="Native control-object service  " Foreground="#D8EDFF" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14,18,18">
                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CONTROL OBJECT" />
                            <TextBlock x:Name="ControlObjectText" Style="{StaticResource FieldValue}" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusReferenceText" Foreground="#64748B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CONTROL MODEL" />
                            <Border x:Name="ControlModelBadge" Background="#E8EEF6" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                <TextBlock x:Name="ControlModelText" Text="Detecting..." Foreground="#334155" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock x:Name="SequenceText" Foreground="#64748B" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="STATUS VALUE" />
                            <DockPanel LastChildFill="False">
                                <Border x:Name="StatusBadge" DockPanel.Dock="Left" Background="#E8EEF6" CornerRadius="5" Padding="12,5">
                                    <TextBlock x:Name="StatusValueText" Text="Reading..." Foreground="#334155" FontSize="16" FontWeight="SemiBold" />
                                </Border>
                                <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshStatus_Click" Padding="10,4" Margin="8,0,0,0" />
                            </DockPanel>
                            <TextBlock x:Name="StatusReadTimeText" Foreground="#64748B" FontSize="10" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Breaker command" Foreground="#172033" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CommandHintText" Text="The engine detects Direct Operate or SBO automatically." Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,14" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="OpenButton" Style="{StaticResource CommandButton}" Background="#147D64" Click="Open_Click" Content="OPEN" ToolTip="Send an Open command to the selected control object." />
                            <Button x:Name="CloseButton" Style="{StaticResource CommandButton}" Background="#B5472F" Click="CloseCommand_Click" Content="CLOSE" ToolTip="Send a Close command to the selected control object." />
                        </StackPanel>
                        <CheckBox x:Name="LiveCommandArmCheckBox"
                                  Content="Enable live command — IED and test circuit are in a safe condition"
                                  HorizontalAlignment="Center" Margin="0,12,0,0"
                                  Foreground="#8A3D2E" FontWeight="SemiBold"
                                  Click="CommandOption_Changed"
                                  ToolTip="Required before OPEN/CLOSE can be sent. This does not bypass IED interlocking or synchrocheck." />
                        <TextBlock x:Name="ArmHintText" Text="Live command is locked." Foreground="#64748B" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        <TextBlock x:Name="ControlValueText" Text="Control value: -" Foreground="#475569" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Expander x:Name="AdvancedExpander" Header="Advanced control parameters" Margin="0,12,0,0" IsExpanded="False">
                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,6,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,18,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CHECK CONDITIONS" />
                                <WrapPanel>
                                    <CheckBox x:Name="InterlockCheckBox" Content="Interlock check" IsChecked="True" ToolTip="Ask the IED to evaluate interlocking before execution." />
                                    <CheckBox x:Name="SynchroCheckBox" Content="Synchrocheck" IsChecked="False" ToolTip="Ask the IED to evaluate synchronism before execution." />
                                    <CheckBox x:Name="TestCheckBox" Content="Test command" IsChecked="False" Click="CommandOption_Changed" ToolTip="Sets Test=true. A process movement is not expected in test mode." />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ORIGINATOR" />
                                <ComboBox x:Name="OriginatorCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Category" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,18,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ORIG ID" />
                                <TextBox x:Name="OriginIdentifierTextBox" Text="ARIEC61850" MaxLength="64" ToolTip="Originator identifier sent in origin.orIdent." />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="COMMAND TIMEOUT" />
                                <ComboBox x:Name="TimeoutCombo" SelectedIndex="1">
                                    <ComboBoxItem Content="5 seconds" Tag="5" />
                                    <ComboBoxItem Content="10 seconds" Tag="10" />
                                    <ComboBoxItem Content="20 seconds" Tag="20" />
                                    <ComboBoxItem Content="30 seconds" Tag="30" />
                                </ComboBox>
                            </StackPanel>

                            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#F7F9FC" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="ctlNum" />
                                        <TextBlock Style="{StaticResource FieldValue}" Text="Automatic" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="T" />
                                        <TextBlock Style="{StaticResource FieldValue}" Text="Automatic UTC" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Selection" />
                                        <TextBlock Style="{StaticResource FieldValue}" Text="Auto when SBO" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Completion" />
                                        <TextBlock x:Name="CompletionBoundaryText" Style="{StaticResource FieldValue}" Text="Detecting..." />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="Command evidence" Foreground="#172033" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button x:Name="StopButton" DockPanel.Dock="Right" Content="Stop current command" Click="StopCommand_Click" Padding="10,3" IsEnabled="False" />
                                </DockPanel>
                                <DataGrid x:Name="EvidenceGrid" Height="118" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#D8E0EA" BorderThickness="1" RowHeight="23">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="72" />
                                        <DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="120" />
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="110" />
                                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Expander Header="Technical evidence (request, response, AddCause)" Margin="0,8,0,0">
                                    <TextBox x:Name="TechnicalEvidenceTextBox" Height="116" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" Background="#111827" Foreground="#D8E4F0" />
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#EAF0F7" BorderBrush="#CDD7E3" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="FooterStatusText" DockPanel.Dock="Left" Text="Initializing control object..." Foreground="#41536A" FontSize="11" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Close" Click="Dismiss_Click" Padding="16,3" Margin="8,4,0,4" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
