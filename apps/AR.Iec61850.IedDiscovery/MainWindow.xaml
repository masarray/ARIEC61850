<Window x:Class="AR.Iec61850.IedDiscovery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AR.Iec61850.IedDiscovery.ViewModels"
        Title="ARIEC61850 IED Discovery Workbench" Height="860" Width="1360" MinHeight="760" MinWidth="1180"
        Background="#F3F6FA" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="ShellBlue" Color="#0B5FA5" />
        <SolidColorBrush x:Key="ExplorerDark" Color="#435061" />
        <SolidColorBrush x:Key="ExplorerDarker" Color="#364252" />
        <SolidColorBrush x:Key="LineBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="SubtleText" Color="#667085" />

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6" Background="{TemplateBinding Background}" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E8F1FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D5E8F8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EEF7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="14,14,14,8" />
        </Style>

        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Background" Value="#4B5666" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFFFFF" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="ColumnHeaderHeight" Value="26" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="AlternatingRowBackground" Value="#DDE3EA" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:IedExplorerNode}" ItemsSource="{Binding Children}">
            <DockPanel MinHeight="21" LastChildFill="True">
                <Border DockPanel.Dock="Left" Width="28" Height="16" CornerRadius="2" Margin="0,2,6,2" Background="#1E8BF0">
                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Title}" Foreground="#F5F8FC" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" Foreground="#FFB25C" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource ShellBlue}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="  ARIEC61850 IED Discovery Workbench" VerticalAlignment="Center" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Right" Text="Engine-first alpha  " VerticalAlignment="Center" Foreground="#D9ECFF" FontSize="12" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#C5D0DD" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="8,6">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Click="OpenScl_Click">
                        <StackPanel><TextBlock Text="📂" FontSize="19" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="Open SCL"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="SaveScl_Click" IsEnabled="{Binding CanExport}">
                        <StackPanel><TextBlock Text="💾" FontSize="19" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="Save SCL"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="Discover_Click">
                        <StackPanel><TextBlock Text="🔎" FontSize="19" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="Discover"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="CloseIed_Click" IsEnabled="{Binding CanClose}">
                        <StackPanel><TextBlock Text="✕" FontSize="19" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="Close IED"/></StackPanel>
                    </Button>
                </StackPanel>
                <Border DockPanel.Dock="Left" Width="1" Background="#CAD5E2" Margin="10,4" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Click="Online_Click" IsEnabled="{Binding IsConnected}">
                        <StackPanel><TextBlock Text="{Binding OnlineIcon}" Foreground="{Binding OnlineBrush}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="{Binding OnlineLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="Read_Click" IsEnabled="{Binding CanRead}">
                        <StackPanel><TextBlock Text="📖" FontSize="19" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="Read"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="ReadAll_Click" IsEnabled="{Binding CanReadAll}">
                        <StackPanel><TextBlock Text="📚" FontSize="19" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="Read all"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="EnableRcb_Click" IsEnabled="{Binding CanEnableReport}">
                        <StackPanel><TextBlock Text="☊" FontSize="19" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="{Binding EnableRcbLabel}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="Control_Click" IsEnabled="{Binding CanControl}">
                        <StackPanel><TextBlock Text="⚡" FontSize="19" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="Control"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="Pin_Click" IsEnabled="{Binding CanPin}">
                        <StackPanel><TextBlock Text="📌" FontSize="19" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="Pin"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="Unpin_Click" IsEnabled="{Binding CanUnpin}">
                        <StackPanel><TextBlock Text="⌫" FontSize="19" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="Unpin"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="Export_Click" IsEnabled="{Binding CanExport}">
                        <StackPanel><TextBlock Text="⤓" FontSize="19" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource ToolbarText}" Text="Export"/></StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#405166" FontSize="12" VerticalAlignment="Center" Margin="18,0,10,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource ExplorerDark}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="IEDs" />
                    <Border Grid.Row="1" Background="#526073" BorderBrush="#6F7A8A" BorderThickness="1" Margin="14,0,14,10" Padding="10" Height="52">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="12" Height="12" Fill="#32D583" Margin="0,0,8,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Host}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding Summary}" Foreground="#CED8E6" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TreeView Grid.Row="2" ItemsSource="{Binding ExplorerNodes}" SelectedItemChanged="ExplorerTree_SelectedItemChanged" Background="Transparent" BorderThickness="0" Foreground="White" Margin="8,0,4,8" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="#9AA7B6" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2" Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PanelHeader}">
                    <TextBlock Text="{Binding SelectedHeader}" Foreground="White" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <Border Grid.Row="1" BorderBrush="#C5D0DD" BorderThickness="0,0,0,1" Padding="10,7" Background="White">
                    <TextBlock Text="{Binding SelectedSubHeader}" Foreground="#405166" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <DataGrid Grid.Row="2" ItemsSource="{Binding DetailRows}" SelectionMode="Single" x:Name="DetailGrid" SelectedItem="{Binding SelectedDetailRow, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="1.15*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Left" Content="{Binding ExpanderGlyph}" Visibility="{Binding ExpanderVisibility}" Click="DetailRowExpander_Click" Width="18" Height="18" Padding="0" Margin="0,0,2,0" BorderThickness="0" Background="Transparent" Foreground="#334155" Cursor="Hand" />
                                        <TextBlock Text="{Binding Name}" Margin="{Binding NameMargin}" FontWeight="{Binding NameWeight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="FC" Binding="{Binding Fc}" Width="54" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="105" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2.1*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" Background="#9AA7B6" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="4" Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PanelHeader}">
                    <TextBlock Text="Activity Monitor" Foreground="White" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding MonitorSignals}" SelectedItem="{Binding SelectedMonitorSignal, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Signal" Binding="{Binding DisplayName}" Width="1.5*" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120" />
                        <DataGridTextColumn Header="Q" Binding="{Binding Quality}" Width="60" />
                        <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="2" Background="#EDF2F7" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="  Polling:" VerticalAlignment="Center" Foreground="#405166" />
                    <ComboBox DockPanel.Dock="Left" Width="80" SelectedIndex="1" Margin="8,4">
                        <ComboBoxItem Content="Manual" />
                        <ComboBoxItem Content="1 s" />
                        <ComboBoxItem Content="5 s" />
                    </ComboBox>
                    <TextBlock DockPanel.Dock="Right" Text="Polling monitor active when Online. Reports update this panel after RCB enable.  " VerticalAlignment="Center" Foreground="#667085" FontSize="11" />
                </DockPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Background="#111827">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Background="#1F2937">
                <TextBlock DockPanel.Dock="Left" Text="  Status History" Foreground="White" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Information / warnings / errors are kept in a capped ring buffer" Foreground="#CBD5E1" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0" />
                    <Button Content="Clear" Click="ClearStatus_Click" Margin="0,3,8,3" Padding="14,1" />
                </StackPanel>
            </DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding StatusHistory}" Background="#F8FAFC" AlternatingRowBackground="#EEF2F7">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="80" />
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="180" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
