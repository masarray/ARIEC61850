<Window x:Class="AR.Iec61850.IedSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARIEC61850 IED Simulator" Height="820" Width="1320" MinHeight="720" MinWidth="1120"
        Background="#E9EEF5" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryToolbarButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#155E9F" />
            <Setter Property="BorderBrush" Value="#155E9F" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
            <Grid Margin="12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="IED Simulator" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Border Background="#E0F2FE" BorderBrush="#7DD3FC" BorderThickness="1" Padding="8,3" Margin="12,0,0,0">
                            <TextBlock Text="Read-only MMS" FontSize="11" FontWeight="SemiBold" Foreground="#075985" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ServerEndpoint}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </StackPanel>
                </DockPanel>

                <WrapPanel Grid.Row="2">
                    <Button Content="Open SCL" Click="OpenScl_Click" Style="{StaticResource PrimaryToolbarButton}" />
                    <Button Content="Start" Click="Start_Click" Style="{StaticResource PrimaryToolbarButton}" />
                    <Button Content="Stop" Click="Stop_Click" Style="{StaticResource ToolbarButton}" />
                    <Button Content="Step" Click="Step_Click" Style="{StaticResource ToolbarButton}" />
                    <Button Content="Reset" Click="Reset_Click" Style="{StaticResource ToolbarButton}" />
                    <Button Content="Export" Click="Export_Click" Style="{StaticResource ToolbarButton}" />
                    <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" ToolTip="Copy MMS protocol diagnostics to the clipboard" Style="{StaticResource ToolbarButton}" MinWidth="126" />
                    <TextBlock Text="{Binding ProfileSummary}" FontSize="12" Foreground="#475569" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,0" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#155E9F" BorderBrush="#0E497B" BorderThickness="0,0,1,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="IEDs" FontSize="12" FontWeight="SemiBold" Foreground="#DBEAFE" />
                        <Border Background="#0F4F86" BorderBrush="#2A79B8" BorderThickness="1" Padding="10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ServerEndpoint}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding ServerStatus}" FontSize="11" Foreground="#DBEAFE" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F4F86" BorderBrush="#2A79B8" BorderThickness="1" Padding="10" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#BFDBFE" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TabControl Grid.Row="4" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Data Model">
                            <ListBox ItemsSource="{Binding Points}" DisplayMemberPath="Reference" FontSize="12"
                                     Background="#0F4F86" Foreground="#FFFFFF" BorderThickness="0" />
                        </TabItem>
                        <TabItem Header="DataSets">
                            <ListBox ItemsSource="{Binding DataSets}" DisplayMemberPath="Reference" FontSize="12"
                                     Background="#0F4F86" Foreground="#FFFFFF" BorderThickness="0" />
                        </TabItem>
                        <TabItem Header="Reports">
                            <ListBox ItemsSource="{Binding Reports}" DisplayMemberPath="Reference" FontSize="12"
                                     Background="#0F4F86" Foreground="#FFFFFF" BorderThickness="0" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CBD5E1" />

            <Grid Grid.Column="2" Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#155E9F" Padding="10,0">
                    <DockPanel>
                        <TextBlock Text="Data Model" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Status}" Foreground="#DBEAFE" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Points}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Reference}" Width="2.4*" />
                        <DataGridTextColumn Header="FC" Binding="{Binding FunctionalConstraint}" Width="54" />
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="92" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="110" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="62" />
                        <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="82" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="96" />
                        <DataGridTextColumn Header="UTC" Binding="{Binding Timestamp}" Width="108" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#CBD5E1" />

            <Grid Grid.Column="4" Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#155E9F" Padding="10,0">
                    <TextBlock Text="Activity Monitor" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>
                <TabControl Grid.Row="1" BorderThickness="0">
                    <TabItem Header="MMS">
                        <DataGrid ItemsSource="{Binding Activities}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="76" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="96" />
                                <DataGridTextColumn Header="Op" Binding="{Binding Operation}" Width="82" />
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="100" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="58" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="1.7*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Events">
                        <DataGrid ItemsSource="{Binding Events}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="76" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*" />
                                <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="118" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="92" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#111827" Padding="12,0">
            <DockPanel>
                <TextBlock Text="{Binding Status}" Foreground="#E5E7EB" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ServerStatus}" Foreground="#BAE6FD" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
