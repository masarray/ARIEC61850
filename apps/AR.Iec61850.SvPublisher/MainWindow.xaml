                                            <TextBox Text="{Binding FrequencyHzText, UpdateSourceTrigger=PropertyChanged}" Tag="FrequencyHz" TextAlignment="Right" LostFocus="ManualNumericTextBox_LostFocus" PreviewKeyDown="ManualNumericTextBox_PreviewKeyDown" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
