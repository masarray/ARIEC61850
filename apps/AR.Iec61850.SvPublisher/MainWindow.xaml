<Window x:Class="AR.Iec61850.SvPublisher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AR.Iec61850.SvPublisher.Controls"
        mc:Ignorable="d"
        Title="AR IEC 61850 SV Publisher"
        Width="1380"
        Height="820"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Background="#F3F5F7">
    <Window.Resources>
        <SolidColorBrush x:Key="TextStrong" Color="#111827" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="Line" Color="#D7DEE8" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Subtle" Color="#F8FAFC" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <SolidColorBrush x:Key="Danger" Color="#B91C1C" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="PanelShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="31" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Danger}" />
            <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EAF1" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2F7" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SV Publisher" FontSize="21" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBlock Text="{Binding StreamControlBlock}" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Manual" Click="ManualMode_Click" />
                    <Button Content="Ramp..." Click="RampSetup_Click" />
                    <Button Content="State Sequencer..." Click="StateSequencer_Click" MinWidth="126" />
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="8,0,0,0">
                        <TextBlock>
                            <Run Text="Mode " />
                            <Run Text="{Binding Mode}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="SCL / Config..." Click="OpenConfig_Click" MinWidth="112" />
                    <Button Content="Run Dry" Command="{Binding RunDryCommand}" Style="{StaticResource PrimaryButton}" />
                    <CheckBox Content="Arm NIC"
                              IsChecked="{Binding IsLiveArmed}"
                              Foreground="#991B1B"
                              VerticalAlignment="Center"
                              Margin="2,0,10,0" />
                    <Button Content="Run NIC" Command="{Binding RunLiveCommand}" Style="{StaticResource DangerButton}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelShell}" Margin="0,0,12,0">
                <DockPanel Margin="18">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Injection values" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Edit secondary current, voltage, phase angle, and frequency."
                                   FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="0,2,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Frequency" Style="{StaticResource LabelText}" />
                            <TextBox Grid.Column="1" Text="{Binding NominalFrequencyHz, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="Duration" Style="{StaticResource LabelText}" Margin="12,0,0,0" />
                            <TextBox Grid.Column="3" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Text="Sample rate" Style="{StaticResource LabelText}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SampleRateHz, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                      Content="Continuous"
                                      IsChecked="{Binding Continuous}"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource Subtle}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DataSet" Style="{StaticResource LabelText}" />
                                <TextBlock>
                                    <Run Text="{Binding DataSetEntryCount, Mode=OneWay}" />
                                    <Run Text=" entries, " />
                                    <Run Text="{Binding MappedSignalCount, Mode=OneWay}" />
                                    <Run Text=" mapped" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Payload" Style="{StaticResource LabelText}" />
                                <TextBlock>
                                    <Run Text="{Binding PayloadBytes, Mode=OneWay}" />
                                    <Run Text=" bytes" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding Channels}"
                              SelectedItem="{Binding SelectedRampChannel}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled}" Width="44" />
                            <DataGridTextColumn Header="Signal" Binding="{Binding Name}" IsReadOnly="True" Width="60" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Magnitude, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="48" />
                            <DataGridTextColumn Header="Angle" Binding="{Binding AngleDegrees, UpdateSourceTrigger=PropertyChanged}" Width="76" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelShell}" Margin="0,0,12,0">
                <DockPanel Margin="18">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Phasor" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Drag-style vector view equivalent: current and voltage are normalized separately."
                                   FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="0,2,0,14" />
                    </StackPanel>
                    <controls:PhasorPlot Channels="{Binding Channels}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelShell}">
                <DockPanel Margin="18">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Waveform" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Representative time signal view for three-phase voltage and current."
                                   FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="0,2,0,14" />
                    </StackPanel>
                    <controls:WaveformPlot Channels="{Binding Channels}" />
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#334155" />
                <TextBlock Grid.Column="1" Text="{Binding PublishText}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
