<Window x:Class="AR.Iec61850.SvPublisher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AR.Iec61850.SvPublisher.Controls"
        mc:Ignorable="d"
        Title="AR IEC 61850 SV Injector - Test Workspace"
        Width="1460"
        Height="860"
        MinWidth="1220"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Background="#F3F5F7">
    <Window.InputBindings>
        <KeyBinding Key="F6" Command="{Binding StopCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="TextStrong" Color="#111827" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="Line" Color="#D7DEE8" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Subtle" Color="#F8FAFC" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
        <SolidColorBrush x:Key="RibbonBlue" Color="#24558E" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="PanelShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Background" Value="#3E7CC9" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.10" Color="#0F172A" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD" />
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16" Color="#1E3A8A" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.10" Color="#0F172A" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="RibbonButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="66" />
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0" />
                        <GradientStop Color="#F5F8FC" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="StateCardButton" TargetType="Button">
            <Setter Property="Width" Value="280" />
            <Setter Property="Height" Value="196" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderBrush" Value="#D7DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="ModernGridCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="#E6ECF3" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border x:Name="CellBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="8,0,8,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CellBorder" Property="Background" Value="#DBEAFE" />
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#718096" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#95A3B6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style x:Key="ModernScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome" Background="#B8C2D1" CornerRadius="5" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Thumb" BasedOn="{StaticResource ModernScrollThumb}" />

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="11" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="11" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#D6DEE9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EAF1" />
            <Setter Property="VerticalGridLinesBrush" Value="#E5EAF1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="29" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="CellOrRowHeader" />
            <Setter Property="CellStyle" Value="{StaticResource ModernGridCellStyle}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FBFCFE" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OpenConfig_Click" Style="{StaticResource RibbonButton}" MinWidth="98">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="5" Canvas.Top="3" Width="14" Height="18" RadiusX="1.5" RadiusY="1.5" Stroke="#334155" StrokeThickness="2" Fill="Transparent"/>
                                    <Polyline Points="14,3 14,8 19,8" Stroke="#334155" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/>
                                    <Line X1="8" Y1="13" X2="16" Y2="13" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="8" Y1="17" X2="14" Y2="17" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="SCL / Config" Style="{StaticResource RibbonCaption}" />
                        </StackPanel>
                    </Button>
                    <Button Click="ManualMode_Click" Style="{StaticResource RibbonButton}" MinWidth="82">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Line X1="4" Y1="3" X2="4" Y2="21" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="12" Y1="3" X2="12" Y2="21" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="20" Y1="3" X2="20" Y2="21" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="2" Y1="14" X2="6" Y2="14" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="10" Y1="8" X2="14" Y2="8" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="18" Y1="12" X2="22" Y2="12" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Manual" Style="{StaticResource RibbonCaption}" />
                        </StackPanel>
                    </Button>
                    <Button Click="RampMode_Click" Style="{StaticResource RibbonButton}" MinWidth="82">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Polyline Points="3,17 7,17 11,9 15,14 21,4" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    <Line X1="3" Y1="21" X2="21" Y2="21" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Ramp" Style="{StaticResource RibbonCaption}" />
                        </StackPanel>
                    </Button>
                    <Button Click="StateSequencerMode_Click" Style="{StaticResource RibbonButton}" MinWidth="116">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="3" Canvas.Top="5" Width="5" Height="14" RadiusX="1" RadiusY="1" Stroke="#334155" StrokeThickness="2" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="10" Canvas.Top="5" Width="5" Height="14" RadiusX="1" RadiusY="1" Stroke="#334155" StrokeThickness="2" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="17" Canvas.Top="5" Width="4" Height="14" RadiusX="1" RadiusY="1" Stroke="#334155" StrokeThickness="2" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="State Seq" Style="{StaticResource RibbonCaption}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Column="1" Background="#CBD5E1" Margin="7,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsRampWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Command="{Binding AddRampStateCommand}" Style="{StaticResource RibbonButton}" MinWidth="98">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Line X1="12" Y1="5" X2="12" Y2="19" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="5" Y1="12" X2="19" Y2="12" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Append Ramp" Style="{StaticResource RibbonCaption}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveRampStateCommand}" Style="{StaticResource RibbonButton}" MinWidth="96">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Line X1="3" Y1="6" X2="21" Y2="6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Polyline Points="8,6 8,4 16,4 16,6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    <Polyline Points="6,6 7,22 17,22 18,6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Delete Ramp" Style="{StaticResource RibbonCaption}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsSequencerWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Command="{Binding AddSequenceStateCommand}" Style="{StaticResource RibbonButton}" MinWidth="98">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Line X1="12" Y1="5" X2="12" Y2="19" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="5" Y1="12" X2="19" Y2="12" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Append State" Style="{StaticResource RibbonCaption}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveSequenceStateCommand}" Style="{StaticResource RibbonButton}" MinWidth="96">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Line X1="3" Y1="6" X2="21" Y2="6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Polyline Points="8,6 8,4 16,4 16,6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    <Polyline Points="6,6 7,22 17,22 18,6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Delete State" Style="{StaticResource RibbonCaption}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsManualWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Command="{Binding ApplyNominalCommand}" Style="{StaticResource RibbonButton}" MinWidth="90">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Polyline Points="12,2 20,5 20,12 18,16 12,22 6,16 4,12 4,5 12,2" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Prefault" Style="{StaticResource RibbonCaption}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ZeroOutputCommand}" Style="{StaticResource RibbonButton}" MinWidth="96">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Stroke="#334155" StrokeThickness="2" Fill="Transparent"/>
                                    <Line X1="8" Y1="16" X2="16" Y2="8" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Zero Output" Style="{StaticResource RibbonCaption}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Column="3" Background="#CBD5E1" Margin="7,0" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RunLiveCommand}" Style="{StaticResource DangerButton}" MinWidth="118" Height="58">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Polygon Points="6,4 20,12 6,20" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Start Injection" Style="{StaticResource RibbonCaption}" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" MinWidth="94" Height="58">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="6" Canvas.Top="6" Width="12" Height="12" RadiusX="1" RadiusY="1" Stroke="#FFFFFF" StrokeThickness="2" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Stop F6" Style="{StaticResource RibbonCaption}" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Column="5" Background="#E2E8F0" Margin="8,8" />

                <StackPanel Grid.Column="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding WorkspaceTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8" />
                    </Border>
                    <TextBlock Text="F6 Stop" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <!-- MANUAL WORKSPACE -->
            <Grid Visibility="{Binding IsManualWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelShell}" Margin="0,0,8,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <TextBlock Text="Test View: Quick Manual" Foreground="White" FontWeight="SemiBold" />
                        </Border>

                        <Border DockPanel.Dock="Bottom"
                                Background="{StaticResource Subtle}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="12,8,12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DataSet" Style="{StaticResource LabelText}" />
                                    <TextBlock>
                                        <Run Text="{Binding DataSetEntryCount, Mode=OneWay}" />
                                        <Run Text=" entries, " />
                                        <Run Text="{Binding MappedSignalCount, Mode=OneWay}" />
                                        <Run Text=" mapped" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Payload" Style="{StaticResource LabelText}" />
                                    <TextBlock>
                                        <Run Text="{Binding PayloadBytes, Mode=OneWay}" />
                                        <Run Text=" bytes" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Set Mode" Style="{StaticResource LabelText}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ManualSetModes}" SelectedItem="{Binding ManualSetMode}" />
                                <TextBlock Grid.Column="2" Text="Duration" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                                <TextBox Grid.Column="3" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sample rate" Style="{StaticResource LabelText}" />
                                <TextBox Grid.Column="1" Text="{Binding SampleRateHz, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="Run behavior" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="3" Text="continuous, live auto-apply" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <DataGrid x:Name="ManualOutputsGrid"
                                  ItemsSource="{Binding ManualRows}"
                                  Margin="12,0,12,0"
                                  PreviewMouseLeftButtonDown="ManualOutputsGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseRightButtonDown="ManualOutputsGrid_PreviewMouseRightButtonDown"
                                  PreviewTextInput="ManualOutputsGrid_PreviewTextInput">
                            <DataGrid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Signal naming" Visibility="{Binding IsContextSignalColumn, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <MenuItem Header="ABC" Command="{Binding SetSignalNamingCommand}" CommandParameter="ABC" />
                                        <MenuItem Header="RSTN" Command="{Binding SetSignalNamingCommand}" CommandParameter="RSTN" />
                                        <MenuItem Header="L1 / L2 / L3 / E" Command="{Binding SetSignalNamingCommand}" CommandParameter="L1L2L3E" />
                                        <MenuItem Header="Raw keys" Command="{Binding SetSignalNamingCommand}" CommandParameter="RAW" />
                                    </MenuItem>

                                    <MenuItem Header="Nominal Value" Command="{Binding NominalValueFromContextCommand}" Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem Header="Zero" Command="{Binding ZeroFromContextCommand}" Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem Header="Equal Magnitudes" Command="{Binding EqualMagnitudesFromContextCommand}" Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem Header="100 % Load" Command="{Binding HundredPercentLoadCommand}" Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem Header="50 % Load" Command="{Binding FiftyPercentLoadCommand}" Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem Header="Unload (0%)" Command="{Binding UnloadCommand}" Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <MenuItem Header="Zero" Command="{Binding ZeroFromContextCommand}" Visibility="{Binding IsContextAngleColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem Header="Line Angle" Command="{Binding LineAngleFromContextCommand}" Visibility="{Binding IsContextAngleColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem Header="Balance Angles" Command="{Binding BalanceAnglesFromContextCommand}" Visibility="{Binding IsContextAngleColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem Header="Reverse Rotation" Command="{Binding ReverseRotationFromContextCommand}" Visibility="{Binding IsContextAngleColumn, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <MenuItem Header="Nominal Value" Command="{Binding NominalFrequencyFromContextCommand}" Visibility="{Binding IsContextFrequencyColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem Header="DC" Command="{Binding DcFrequencyFromContextCommand}" Visibility="{Binding IsContextFrequencyColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem Header="Equal Frequencies" Command="{Binding EqualFrequenciesFromContextCommand}" Visibility="{Binding IsContextFrequencyColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource ModernCheckBoxStyle}" EditingElementStyle="{StaticResource ModernCheckBoxStyle}" Width="42" />
                                <DataGridTextColumn Header="Signal" Binding="{Binding Name}" IsReadOnly="True" Width="88" />

                                <DataGridTemplateColumn Header="Value" Width="98" SortMemberPath="Magnitude">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MagnitudeText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding MagnitudeText, UpdateSourceTrigger=PropertyChanged}" Tag="Magnitude" TextAlignment="Right" LostFocus="ManualNumericTextBox_LostFocus" PreviewKeyDown="ManualNumericTextBox_PreviewKeyDown" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Angle" Width="86" SortMemberPath="AngleDegrees">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AngleDegreesText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding AngleDegreesText, UpdateSourceTrigger=PropertyChanged}" Tag="AngleDegrees" TextAlignment="Right" LostFocus="ManualNumericTextBox_LostFocus" PreviewKeyDown="ManualNumericTextBox_PreviewKeyDown" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Freq" Width="92" SortMemberPath="FrequencyHz">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FrequencyHzText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding FrequencyHzText, UpdateSourceTrigger=PropertyChanged}" Tag="FrequencyHz" TextAlignment="Right" LostFocus="ManualNumericTextBox_LostFocus" PreviewKeyDown="ManualNumericTextBox_PreviewKeyDown" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelShell}" Margin="0,0,8,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <TextBlock Text="Phasor View: Effective SV Outputs" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <controls:PhasorPlot Channels="{Binding Channels}" Margin="12" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelShell}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <TextBlock Text="Waveform / Injection Monitor" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="112" />
                            </Grid.RowDefinitions>
                            <controls:WaveformPlot Channels="{Binding Channels}" />
                            <Border Grid.Row="1" Background="{StaticResource Subtle}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Nominal frequency" Style="{StaticResource LabelText}" />
                                        <TextBox Text="{Binding NominalFrequencyHz, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left" />
                                        <CheckBox Content="Link Frequencies" IsChecked="{Binding LinkFrequencies}" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Selected adapter" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding AdapterStatusText}" TextWrapping="Wrap" Foreground="#334155" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- RAMP WORKSPACE -->
            <Grid Visibility="{Binding IsRampWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42*" />
                    <ColumnDefinition Width="58*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="210" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource PanelShell}" Margin="0,0,8,8">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <TextBlock Text="Test View: Ramping" Foreground="White" FontWeight="SemiBold" />
                        </Border>

                        <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="126" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Set mode:" Style="{StaticResource LabelText}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ManualSetModes}" SelectedItem="{Binding ManualSetMode}" />
                            <TextBlock Grid.Column="2" Text="Fault type:" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                            <ComboBox Grid.Column="3" IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="n/a" />
                            </ComboBox>
                            <TextBlock Grid.Column="4" Text="Estimated test time:" Style="{StaticResource LabelText}" HorizontalAlignment="Right" Margin="10,0,8,0" />
                            <TextBox Grid.Column="5" Text="{Binding RampTotalTimeText, Mode=OneWay}" IsReadOnly="True" />
                        </Grid>

                        <Grid DockPanel.Dock="Top" Margin="10,0,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="152" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="152" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Signal 1:" Style="{StaticResource LabelText}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RampSignalChoices}"
                                      SelectedItem="{Binding SelectedRampSignalChoice, Mode=TwoWay}"
                                      DisplayMemberPath="Name" />
                            <TextBlock Grid.Column="2" Text="Quantity 1:" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                            <ComboBox Grid.Column="3" ItemsSource="{Binding RampQuantities}" SelectedIndex="0" />
                            <TextBlock Grid.Column="4" Text="Signal 2:" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                            <ComboBox Grid.Column="5" IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="(none)" />
                            </ComboBox>
                            <TextBlock Grid.Column="6" Text="Quantity 2:" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                            <ComboBox Grid.Column="7" IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="Frequency" />
                            </ComboBox>
                        </Grid>

                        <DataGrid x:Name="RampStatesGrid"
                                  ItemsSource="{Binding RampStates}"
                                  SelectedItem="{Binding SelectedRampState, Mode=TwoWay}"
                                  SelectionUnit="CellOrRowHeader"
                                  Margin="10,0,10,10"
                                  PreviewMouseLeftButtonDown="RampStatesGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseRightButtonDown="RampStatesGrid_PreviewMouseRightButtonDown"
                                  PreviewTextInput="RampStatesGrid_PreviewTextInput">
                            <DataGrid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Append Ramp" Command="{Binding AddRampStateCommand}" />
                                    <MenuItem Header="Delete Ramp" Command="{Binding RemoveRampStateCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Ramp" Width="70" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Padding="8,0,8,0" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="From" Width="92" SortMemberPath="From">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding FromText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate><TextBox Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" Tag="From" TextAlignment="Right" LostFocus="RampStateTextBox_LostFocus" PreviewKeyDown="RampStateTextBox_PreviewKeyDown" /></DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="To" Width="92" SortMemberPath="To">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding ToText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate><TextBox Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" Tag="To" TextAlignment="Right" LostFocus="RampStateTextBox_LostFocus" PreviewKeyDown="RampStateTextBox_PreviewKeyDown" /></DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Delta" Binding="{Binding DeltaText, Mode=OneWay}" IsReadOnly="True" Width="82" />
                                <DataGridTemplateColumn Header="Step" Width="82" SortMemberPath="Step">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StepText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate><TextBox Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}" Tag="Step" TextAlignment="Right" LostFocus="RampStateTextBox_LostFocus" PreviewKeyDown="RampStateTextBox_PreviewKeyDown" /></DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="dt" Width="74" SortMemberPath="StepTimeSeconds">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StepTimeText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate><TextBox Text="{Binding StepTimeText, UpdateSourceTrigger=PropertyChanged}" Tag="StepTimeSeconds" TextAlignment="Right" LostFocus="RampStateTextBox_LostFocus" PreviewKeyDown="RampStateTextBox_PreviewKeyDown" /></DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="d/dt" Binding="{Binding SlopeText, Mode=OneWay}" IsReadOnly="True" Width="88" />
                                <DataGridTemplateColumn Header="Steps" Width="58" SortMemberPath="Steps">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StepsText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate><TextBox Text="{Binding StepsText, UpdateSourceTrigger=PropertyChanged}" Tag="Steps" TextAlignment="Right" LostFocus="RampStateTextBox_LostFocus" PreviewKeyDown="RampStateTextBox_PreviewKeyDown" /></DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Time" Width="80" SortMemberPath="TimeSeconds">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding TimeText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate><TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" Tag="TimeSeconds" TextAlignment="Right" LostFocus="RampStateTextBox_LostFocus" PreviewKeyDown="RampStateTextBox_PreviewKeyDown" /></DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource PanelShell}" Margin="0,0,0,8">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <TextBlock Text="Signal View: Ramping" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="74" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding RampStates}"
                                      SelectedItem="{Binding SelectedRampState, Mode=TwoWay}"
                                      HeadersVisibility="Column"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText, Mode=OneWay}" Width="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Signal" Binding="{Binding SignalName}" Width="120" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding ToText, Mode=OneWay}" Width="120" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Ramp time" Binding="{Binding TimeText, Mode=OneWay}" Width="*" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <controls:RampTimelinePlot Grid.Row="1" RampStates="{Binding RampStates}" Margin="0,8,0,0" />
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource PanelShell}" Margin="0,0,8,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <TextBlock Text="Detail View: Analog Out" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <DataGrid x:Name="RampAnalogOutGrid"
                                  Margin="8"
                                  ItemsSource="{Binding ManualRows}"
                                  SelectionUnit="CellOrRowHeader"
                                  PreviewMouseLeftButtonDown="ManualOutputsGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseRightButtonDown="ManualOutputsGrid_PreviewMouseRightButtonDown"
                                  PreviewTextInput="ManualOutputsGrid_PreviewTextInput">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource ModernCheckBoxStyle}" EditingElementStyle="{StaticResource ModernCheckBoxStyle}" Width="42" />
                                <DataGridTextColumn Header="Signal" Binding="{Binding Name}" IsReadOnly="True" Width="90" />
                                <DataGridTemplateColumn Header="Value" Width="110" SortMemberPath="Magnitude">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding MagnitudeText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate><TextBox Text="{Binding MagnitudeText, UpdateSourceTrigger=PropertyChanged}" Tag="Magnitude" TextAlignment="Right" LostFocus="ManualNumericTextBox_LostFocus" PreviewKeyDown="ManualNumericTextBox_PreviewKeyDown" /></DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Angle" Width="100" SortMemberPath="AngleDegrees">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding AngleDegreesText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate><TextBox Text="{Binding AngleDegreesText, UpdateSourceTrigger=PropertyChanged}" Tag="AngleDegrees" TextAlignment="Right" LostFocus="ManualNumericTextBox_LostFocus" PreviewKeyDown="ManualNumericTextBox_PreviewKeyDown" /></DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Freq" Width="100" SortMemberPath="FrequencyHz">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding FrequencyHzText}" TextAlignment="Right" Padding="6,0,8,0" VerticalAlignment="Center" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate><TextBox Text="{Binding FrequencyHzText, UpdateSourceTrigger=PropertyChanged}" Tag="FrequencyHz" TextAlignment="Right" LostFocus="ManualNumericTextBox_LostFocus" PreviewKeyDown="ManualNumericTextBox_PreviewKeyDown" /></DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource PanelShell}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <TextBlock Text="Phasor View: Selected Ramp Output" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <controls:PhasorPlot Channels="{Binding RampPreviewChannels}" Margin="8" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- STATE SEQUENCER WORKSPACE -->
            <Grid Visibility="{Binding IsSequencerWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="238" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource PanelShell}" Margin="0,0,0,8">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <TextBlock Text="Table View: State Sequencer" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="6">
                            <ItemsControl ItemsSource="{Binding SequenceStates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1F2937"
                                                BorderThickness="0,0,2,0"
                                                Width="308"
                                                Margin="0"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="SequenceStateCard_MouseLeftButtonDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#EAF2FF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="25" />
                                                    <RowDefinition Height="25" />
                                                    <RowDefinition Height="25" />
                                                    <RowDefinition Height="25" />
                                                    <RowDefinition Height="25" />
                                                    <RowDefinition Height="25" />
                                                    <RowDefinition Height="25" />
                                                    <RowDefinition Height="31" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="82" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.ColumnSpan="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#7B8A9B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="#3E7CC9" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Foreground="White"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             FontWeight="SemiBold"
                                                             Padding="0"
                                                             GotKeyboardFocus="SequenceStateTextBox_GotKeyboardFocus" />
                                                </Border>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="V L1-E" Margin="7,5,0,0" />
