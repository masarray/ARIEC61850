                                                        <Rectangle Width="12" Height="2" Fill="{Binding Key, Converter={StaticResource SignalBrushConverter}}" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0" FontSize="11" Foreground="#334155" />
                                                        <TextBlock Grid.Column="2" Text="{Binding MagnitudeText}" FontSize="11" Foreground="#0F172A" />
                                                    </Grid>
