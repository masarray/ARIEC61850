<Window x:Class="AR.Iec61850.SvPublisher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AR.Iec61850.SvPublisher.Controls"
        mc:Ignorable="d"
        Title="AR IEC 61850 SV Injector - Manual Test Console"
        Width="1440"
        Height="820"
        MinWidth="1220"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Background="#F3F5F7">
    <Window.InputBindings>
        <KeyBinding Key="F6" Command="{Binding StopCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="TextStrong" Color="#111827" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="Line" Color="#D7DEE8" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Subtle" Color="#F8FAFC" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
        <SolidColorBrush x:Key="RibbonBlue" Color="#24558E" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="PanelShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Background" Value="#3E7CC9" />
            <Setter Property="CornerRadius" Value="7,7,0,0" />
            <Setter Property="Padding" Value="9,5" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="31" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Danger}" />
            <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="RibbonButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="52" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F8FAFC" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#C7D0DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EAF1" />
            <Setter Property="VerticalGridLinesBrush" Value="#E5EAF1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="27" />
            <Setter Property="ColumnHeaderHeight" Value="27" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="CellOrRowHeader" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource RibbonBlue}">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AR IEC 61850 SV Injector" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="  -  Quick manual sampled-value console" Foreground="#D7E7FF" FontSize="12" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="F6 Stop Injection" Foreground="#D7E7FF" VerticalAlignment="Center" FontSize="12" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="SCL / Config" Click="OpenConfig_Click" Style="{StaticResource RibbonButton}" MinWidth="98" />
                    <Button Content="Manual" Click="ManualMode_Click" Style="{StaticResource RibbonButton}" MinWidth="82" />
                    <Button Content="Ramp..." Click="RampSetup_Click" Style="{StaticResource RibbonButton}" MinWidth="82" />
                    <Button Content="Sequencer..." Click="StateSequencer_Click" Style="{StaticResource RibbonButton}" MinWidth="98" />
                </StackPanel>

                <Border Grid.Column="1" Background="#CBD5E1" Margin="7,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Prefault" Command="{Binding ApplyNominalCommand}" Style="{StaticResource RibbonButton}" />
                    <Button Content="Zero Output" Command="{Binding ZeroOutputCommand}" Style="{StaticResource RibbonButton}" MinWidth="96" />
                </StackPanel>

                <Border Grid.Column="3" Background="#CBD5E1" Margin="7,0" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start Injection" Command="{Binding RunLiveCommand}" Style="{StaticResource DangerButton}" MinWidth="118" Height="52" />
                    <Button Content="Stop (F6)" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" MinWidth="94" Height="52" />
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="4,0,0,0" MinWidth="220">
                        <StackPanel>
                            <TextBlock Text="Active execution mode" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding Mode}" FontWeight="SemiBold" Foreground="#0F172A" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="5" VerticalAlignment="Center" MinWidth="250">
                    <TextBlock Text="{Binding StreamControlBlock}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LiveApplyText}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelShell}" Margin="0,0,10,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Text="Test View: SV Manual Injector" Foreground="White" FontWeight="SemiBold" />
                    </Border>

                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource Subtle}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="12,8,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DataSet" Style="{StaticResource LabelText}" />
                                <TextBlock>
                                    <Run Text="{Binding DataSetEntryCount, Mode=OneWay}" />
                                    <Run Text=" entries, " />
                                    <Run Text="{Binding MappedSignalCount, Mode=OneWay}" />
                                    <Run Text=" mapped" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Payload" Style="{StaticResource LabelText}" />
                                <TextBlock>
                                    <Run Text="{Binding PayloadBytes, Mode=OneWay}" />
                                    <Run Text=" bytes" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Set Mode" Style="{StaticResource LabelText}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ManualSetModes}" SelectedItem="{Binding ManualSetMode}" />
                            <TextBlock Grid.Column="2" Text="Duration" Style="{StaticResource LabelText}" Margin="10,0,0,0" />
                            <TextBox Grid.Column="3" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sample rate" Style="{StaticResource LabelText}" />
                            <TextBox Grid.Column="1" Text="{Binding SampleRateHz, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Grid.Column="2" Content="Continuous" IsChecked="{Binding Continuous}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <CheckBox Grid.Column="3" Content="Auto apply RUN" IsChecked="{Binding AutoApplyWhileRunning}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <DataGrid x:Name="ManualOutputsGrid"
                              ItemsSource="{Binding ManualRows}"
                              Margin="12,0,12,0"
                              PreviewMouseLeftButtonDown="ManualOutputsGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseRightButtonDown="ManualOutputsGrid_PreviewMouseRightButtonDown"
                              PreviewTextInput="ManualOutputsGrid_PreviewTextInput">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Signal naming"
                                          Visibility="{Binding IsContextSignalColumn, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <MenuItem Header="ABC" Command="{Binding SetSignalNamingCommand}" CommandParameter="ABC" />
                                    <MenuItem Header="RSTN" Command="{Binding SetSignalNamingCommand}" CommandParameter="RSTN" />
                                    <MenuItem Header="L1 / L2 / L3 / E" Command="{Binding SetSignalNamingCommand}" CommandParameter="L1L2L3E" />
                                    <MenuItem Header="Raw keys" Command="{Binding SetSignalNamingCommand}" CommandParameter="RAW" />
                                </MenuItem>

                                <MenuItem Header="Nominal Value"
                                          Command="{Binding NominalValueFromContextCommand}"
                                          Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <MenuItem Header="Zero"
                                          Command="{Binding ZeroFromContextCommand}"
                                          Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <MenuItem Header="Equal Magnitudes"
                                          Command="{Binding EqualMagnitudesFromContextCommand}"
                                          Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <MenuItem Header="100 % Load"
                                          Command="{Binding HundredPercentLoadCommand}"
                                          Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <MenuItem Header="50 % Load"
                                          Command="{Binding FiftyPercentLoadCommand}"
                                          Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <MenuItem Header="Unload (0%)"
                                          Command="{Binding UnloadCommand}"
                                          Visibility="{Binding IsContextValueColumn, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <MenuItem Header="Zero"
                                          Command="{Binding ZeroFromContextCommand}"
                                          Visibility="{Binding IsContextAngleColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <MenuItem Header="Line Angle"
                                          Command="{Binding LineAngleFromContextCommand}"
                                          Visibility="{Binding IsContextAngleColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <MenuItem Header="Balance Angles"
                                          Command="{Binding BalanceAnglesFromContextCommand}"
                                          Visibility="{Binding IsContextAngleColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <MenuItem Header="Reverse Rotation"
                                          Command="{Binding ReverseRotationFromContextCommand}"
                                          Visibility="{Binding IsContextAngleColumn, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <MenuItem Header="Nominal Value"
                                          Command="{Binding NominalFrequencyFromContextCommand}"
                                          Visibility="{Binding IsContextFrequencyColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <MenuItem Header="DC"
                                          Command="{Binding DcFrequencyFromContextCommand}"
                                          Visibility="{Binding IsContextFrequencyColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <MenuItem Header="Equal Frequencies"
                                          Command="{Binding EqualFrequenciesFromContextCommand}"
                                          Visibility="{Binding IsContextFrequencyColumn, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="38" />
                            <DataGridTextColumn Header="Signal" Binding="{Binding Name}" IsReadOnly="True" Width="88" />

                            <DataGridTemplateColumn Header="Value" Width="*" SortMemberPath="Magnitude">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MagnitudeText}" TextAlignment="Right" Padding="0,4,6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding MagnitudeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Magnitude"
                                                 TextAlignment="Right"
                                                 LostFocus="ManualNumericTextBox_LostFocus"
                                                 PreviewKeyDown="ManualNumericTextBox_PreviewKeyDown" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Angle" Width="66" SortMemberPath="AngleDegrees">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AngleDegreesText}" TextAlignment="Right" Padding="0,4,6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding AngleDegreesText, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="AngleDegrees"
                                                 TextAlignment="Right"
                                                 LostFocus="ManualNumericTextBox_LostFocus"
                                                 PreviewKeyDown="ManualNumericTextBox_PreviewKeyDown" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Freq" Width="66" SortMemberPath="FrequencyHz">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FrequencyHzText}" TextAlignment="Right" Padding="0,4,6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding FrequencyHzText, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="FrequencyHz"
                                                 TextAlignment="Right"
                                                 LostFocus="ManualNumericTextBox_LostFocus"
                                                 PreviewKeyDown="ManualNumericTextBox_PreviewKeyDown" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="42" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelShell}" Margin="0,0,10,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Text="Phasor View: Effective SV Outputs" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                    <controls:PhasorPlot Channels="{Binding Channels}" Margin="12" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelShell}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Text="Waveform / Injection Monitor" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="112" />
                        </Grid.RowDefinitions>
                        <controls:WaveformPlot Channels="{Binding Channels}" />
                        <Border Grid.Row="1" Background="{StaticResource Subtle}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Nominal frequency" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding NominalFrequencyHz, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left" />
                                    <CheckBox Content="Link Frequencies" IsChecked="{Binding LinkFrequencies}" Margin="0,8,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Publisher status" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding PublishText}" TextWrapping="Wrap" Foreground="#334155" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#334155" />
                <TextBlock Grid.Column="1" Text="{Binding LiveApplyText}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
