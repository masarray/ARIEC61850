        <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#4DA4FF" Offset="0" />
                <GradientStop Color="#2F7CFF" Offset="0.55" />
                <GradientStop Color="#2563EB" Offset="1" />
            </LinearGradientBrush>
        </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="#1D4ED8" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
                <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <TranslateTransform Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.24" Color="#2563EB" />
                        </Border.Effect>
                        <Grid>
                            <Border x:Name="Gloss" Margin="1.5" CornerRadius="12.5" Opacity="0.75" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#72FFFFFF" Offset="0" />
                                        <GradientStop Color="#24FFFFFF" Offset="0.38" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.85" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
