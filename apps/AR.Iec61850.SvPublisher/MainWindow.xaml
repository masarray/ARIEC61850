                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#65B8FF" Offset="0" />
                                    <GradientStop Color="#368BFF" Offset="0.55" />
                                    <GradientStop Color="#2A6BF0" Offset="1" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="Surface" Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.30" Color="#2563EB" />
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="Root" Property="RenderTransform">
                            <Setter.Value>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1.035" ScaleY="1.035" />
                                    <TranslateTransform Y="-2" />
                                </TransformGroup>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Gloss" Property="Opacity" Value="0.35" />
                        <Setter TargetName="Root" Property="RenderTransform">
                            <Setter.Value>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    <TranslateTransform Y="1.5" />
                                </TransformGroup>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="Surface" Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.14" Color="#1E3A8A" />
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>


