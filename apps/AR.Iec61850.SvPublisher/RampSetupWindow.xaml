<Window x:Class="AR.Iec61850.SvPublisher.RampSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ramp setup"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Background="#F3F5F7">
    <Window.Resources>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="Line" Color="#D7DEE8" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="31" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Ramp" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock Text="Select one signal and define its target value over a fixed time."
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,3,0,14" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>

                <TextBlock Text="Ramp signal" Style="{StaticResource LabelText}" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Channels}"
                          SelectedItem="{Binding SelectedRampChannel}"
                          DisplayMemberPath="Name" />

                <TextBlock Grid.Row="1" Text="Target value" Style="{StaticResource LabelText}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RampTargetMagnitude, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Text="Ramp time (s)" Style="{StaticResource LabelText}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RampDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Text="Run duration (s)" Style="{StaticResource LabelText}" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Use Ramp" Click="UseRamp_Click" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
