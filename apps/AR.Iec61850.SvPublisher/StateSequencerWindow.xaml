<Window x:Class="AR.Iec61850.SvPublisher.StateSequencerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="State sequencer"
        Width="760"
        Height="500"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Background="#F3F5F7">
    <Window.Resources>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="Line" Color="#D7DEE8" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <Style TargetType="Button">
            <Setter Property="Height" Value="31" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EAF1" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2F7" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="State sequencer" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock Text="Build a simple pre-fault, fault, and recovery sequence using scale and angle shifts."
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,3,0,14" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Add state" Command="{Binding AddSequenceStateCommand}" />
                    <Button Content="Remove last" Command="{Binding RemoveSequenceStateCommand}" />
                    <CheckBox Content="Loop sequence"
                              IsChecked="{Binding LoopSequence}"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding SequenceStates}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="State" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="Sec" Binding="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" Width="82" />
                        <DataGridTextColumn Header="I scale" Binding="{Binding CurrentScale, UpdateSourceTrigger=PropertyChanged}" Width="92" />
                        <DataGridTextColumn Header="V scale" Binding="{Binding VoltageScale, UpdateSourceTrigger=PropertyChanged}" Width="92" />
                        <DataGridTextColumn Header="Angle shift" Binding="{Binding AngleShiftDegrees, UpdateSourceTrigger=PropertyChanged}" Width="104" />
                        <DataGridTextColumn Header="Hz" Binding="{Binding FrequencyHz, UpdateSourceTrigger=PropertyChanged}" Width="82" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Use Sequencer" Click="UseSequencer_Click" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
