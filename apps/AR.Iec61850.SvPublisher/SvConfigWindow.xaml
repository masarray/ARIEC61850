<Window x:Class="AR.Iec61850.SvPublisher.SvConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCL and SV stream configuration"
        Width="760"
        Height="690"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Background="#F3F7FD">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Subtle" Color="#FBFDFF" />
        <SolidColorBrush x:Key="Line" Color="#D7DEE8" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        
<Style TargetType="Button">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="BorderBrush" Value="#D7E2F0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background">
        <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#F5F9FF" Offset="1" />
            </LinearGradientBrush>
        </Setter.Value>
    </Setter>
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup>
                    </Grid.RenderTransform>
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#183B70"/></Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><TransformGroup><ScaleTransform ScaleX="1.02" ScaleY="1.02"/><TranslateTransform Y="-1"/></TransformGroup></Setter.Value></Setter>
                        <Setter TargetName="Surface" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.18" Color="#2563EB"/></Setter.Value></Setter>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><TransformGroup><ScaleTransform ScaleX="0.98" ScaleY="0.98"/><TranslateTransform Y="1"/></TransformGroup></Setter.Value></Setter>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#1D4ED8" />
    <Setter Property="Background">
        <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#4DA4FF" Offset="0" />
                <GradientStop Color="#2563EB" Offset="1" />
            </LinearGradientBrush>
        </Setter.Value>
    </Setter>
</Style>

<Style TargetType="TextBox">
    <Setter Property="Height" Value="31" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="BorderBrush" Value="#D7DEE8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
</Style>

<Style TargetType="ComboBox">
    <Setter Property="Height" Value="31" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="BorderBrush" Value="#D7DEE8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="#FFFFFF" />
</Style>

<Style x:Key="ModernScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Thumb">
                <Border x:Name="ThumbChrome" Background="#B7C7DC" CornerRadius="4" Margin="2" />
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="#7FB3EA" /></Trigger>
                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="#2F8CFF" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
<Style TargetType="Thumb" BasedOn="{StaticResource ModernScrollThumb}" />
<Style x:Key="InvisibleRepeatButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Rectangle Fill="Transparent" /></ControlTemplate></Setter.Value></Setter>
</Style>
<Style TargetType="ScrollBar">
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleRepeatButton}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ModernScrollThumb}" /></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleRepeatButton}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton></Track></Grid>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
    <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="9" /></Trigger>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="9" /></Trigger>
    </Style.Triggers>
</Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border CornerRadius="14" Background="#FCFEFF" BorderBrush="#E1EAF5" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#183B70" /></Border.Effect>
            <StackPanel>
                <TextBlock Text="SCL and stream setup" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" />
                <TextBlock Text="Open the engineering file, select the SV control block, then check network settings before running."
                           FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Opacity="0.12" Color="#183B70" /></Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Open SCL" Command="{Binding OpenSclCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Comtrade" Command="{Binding ImportComtradeCommand}" />
                        <Button Content="Clear replay" Command="{Binding ClearComtradeCommand}" />
                        <Button Content="Save plan" Command="{Binding SaveProfileCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding SclSummary, Mode=OneWay}" Foreground="#334155" />
                    <TextBlock Text="{Binding SclPath, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,16" />

                    <TextBlock Text="IED / MU publisher slot" Style="{StaticResource LabelText}" />
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding PublisherSlots}"
                                  SelectedItem="{Binding SelectedPublisherSlot}"
                                  DisplayMemberPath="Header" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPublisherSlot.SummaryText}" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                    </Grid>

                    <TextBlock Text="SV stream for selected publisher" Style="{StaticResource LabelText}" />
                    <ComboBox ItemsSource="{Binding Streams}"
                              SelectedItem="{Binding SelectedStream}"
                              DisplayMemberPath="Label"
                              Margin="0,4,0,12" />

                    <TextBlock Text="NIC adapter" Style="{StaticResource LabelText}" />
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="98" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Adapters}"
                                  SelectedItem="{Binding SelectedAdapter}"
                                  DisplayMemberPath="DisplayName" />
                        <Button Grid.Column="1"
                                Content="Refresh"
                                Command="{Binding RefreshAdaptersCommand}"
                                Margin="8,0,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="102" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="svID" Style="{StaticResource LabelText}" />
                        <TextBox Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding StreamId, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Text="DataSet" Style="{StaticResource LabelText}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DataSetReference, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Text="APPID" Style="{StaticResource LabelText}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AppIdText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Dst MAC" Style="{StaticResource LabelText}" Margin="14,0,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding DestinationMac, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Text="Source MAC" Style="{StaticResource LabelText}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SourceMac, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Grid.Row="3" Grid.Column="2" Content="VLAN" IsChecked="{Binding UseVlan}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                            <TextBox Width="68" Text="{Binding VlanId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="prio" Style="{StaticResource LabelText}" Margin="10,0,5,0" />
                            <TextBox Width="46" Text="{Binding VlanPriority, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="Sample rate" Style="{StaticResource LabelText}" />
                        <ComboBox Grid.Row="4" Grid.Column="1"
                                  ItemsSource="{Binding SampleRatePresets}"
                                  SelectedItem="{Binding SelectedSampleRatePreset}"
                                  DisplayMemberPath="Label" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="dLSB I" Style="{StaticResource LabelText}" Margin="14,0,0,0" />
                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding CurrentDlsb, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="5" Text="dLSB V" Style="{StaticResource LabelText}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding VoltageDlsb, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Entries" Style="{StaticResource LabelText}" Margin="14,0,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="3" VerticalAlignment="Center">
                            <Run Text="{Binding DataSetEntryCount, Mode=OneWay}" />
                            <Run Text=" / mapped " />
                            <Run Text="{Binding MappedSignalCount, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Grid.Row="6" Text="Sync policy" Style="{StaticResource LabelText}" />
                        <ComboBox Grid.Row="6" Grid.Column="1"
                                  ItemsSource="{Binding SyncPolicyModes}"
                                  SelectedItem="{Binding SyncPolicyMode}"
                                  Margin="0,4,0,0" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="PTP domain" Style="{StaticResource LabelText}" Margin="14,4,0,0" />
                        <StackPanel Grid.Row="6" Grid.Column="3" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox Width="56" Text="{Binding ExpectedPtpDomain, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Local fallback" IsChecked="{Binding PtpAllowLocalFallback}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="7" Text="SV output" Style="{StaticResource LabelText}" />
                        <CheckBox Grid.Row="7" Grid.Column="1" Content="Enable selected publisher" IsChecked="{Binding SelectedPublisherSlot.IsEnabled}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="Source" Style="{StaticResource LabelText}" Margin="14,0,0,0" />
                        <ComboBox Grid.Row="7" Grid.Column="3" ItemsSource="{Binding SignalSources}" SelectedItem="{Binding SelectedPublisherSlot.SignalSource}" />

                        <TextBlock Grid.Row="8" Text="Replay" Style="{StaticResource LabelText}" />
                        <CheckBox Grid.Row="8" Grid.Column="1" Content="Loop COMTRADE" IsChecked="{Binding SelectedPublisherSlot.ComtradeLoop}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="8" Grid.Column="2" Text="COMTRADE" Style="{StaticResource LabelText}" Margin="14,0,0,0" />
                        <TextBlock Grid.Row="8" Grid.Column="3" Text="{Binding SelectedPublisherSlot.ComtradeSummary}" Foreground="#334155" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="9" Text="PTP Publisher" Style="{StaticResource LabelText}" />
                        <ComboBox Grid.Row="9" Grid.Column="1"
                                  ItemsSource="{Binding PtpPublisherModes}"
                                  SelectedItem="{Binding PtpPublisherMode}"
                                  Margin="0,4,0,0" />
                        <TextBlock Grid.Row="9" Grid.Column="2" Text="Clock ID" Style="{StaticResource LabelText}" Margin="14,4,0,0" />
                        <TextBox Grid.Row="9" Grid.Column="3" Text="{Binding PtpClockIdentityText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />

                        <TextBlock Grid.Row="10" Text="PTP timing" Style="{StaticResource LabelText}" />
                        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Ann" Style="{StaticResource LabelText}" Margin="0,0,5,0" />
                            <TextBox Width="64" Text="{Binding PtpAnnounceIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="ms" Style="{StaticResource LabelText}" Margin="5,0,10,0" />
                            <TextBlock Text="Sync" Style="{StaticResource LabelText}" Margin="0,0,5,0" />
                            <TextBox Width="64" Text="{Binding PtpSyncIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="ms" Style="{StaticResource LabelText}" Margin="5,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="Peer delay" Style="{StaticResource LabelText}" Margin="14,4,0,0" />
                        <CheckBox Grid.Row="10" Grid.Column="3" Content="Respond to Pdelay_Req" IsChecked="{Binding PtpRespondToPeerDelay}" VerticalAlignment="Center" Margin="0,4,0,0" />
                    </Grid>

                    <TextBlock Text="Evidence" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,16,0,8" />
                    <TextBox Text="{Binding EvidenceText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="11"
                             Height="130" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
